# ==============================================================================
# TTI (Telegram Threat Intelligence) — Root .gitignore
# ==============================================================================

# Environment files & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.pkcs12
*.pfx
*.cert
*.crt
id_rsa*
secrets/
*.session
*.session-journal
# Evidence Storage & Untrusted Scraped Data (Non-negotiable security isolation)
evidence_store/
evidence/data/
evidence/raw/
uploads/
*.raw
*.pcap
*.har

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/
junitxml/

# Python Tools
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Node & Frontend
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases (Local development dumps & locks)
*.sqlite
*.sqlite3
*.db
backend/app/database/*.db

# IDE & OS Metadata
.idea/
.vscode/
New folder/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Docker Local Volume mounts
.docker/
docker-data/
postgres_data/
