# ==============================================================================
# TTI (Telegram Threat Intelligence) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# SECURITY NOTICE:
# - NEVER commit real credentials or production secrets to version control.
# - Phase 1 operates in inert connector mode. Real Telegram or Dark Web tokens
#   MUST NOT be configured until formal authorization and Phase 2.
# ==============================================================================

# Application Environment
TTI_ENV=development
TTI_PROJECT_NAME="Telegram Threat Intelligence (TTI)"
TTI_API_V1_STR=/api/v1
TTI_LOG_LEVEL=INFO
TTI_SECRET_KEY=dev_insecure_secret_key_must_be_changed_in_production_min32chars!

# Multi-Tenancy Baseline
# Phase 1 uses an initial development tenant identifier for requests lacking an X-Tenant-ID header.
TTI_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
TTI_DEFAULT_TENANT_NAME="Default Operations Tenant"

# Database Configuration (PostgreSQL 16)
# Used by async application engine (asyncpg)
POSTGRES_USER=tti_user
POSTGRES_PASSWORD=tti_dev_password_change_in_production
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tti_dev

# SQLAlchemy URLs (Computed automatically by backend/app/core/config.py if omitted)
# Async URL for FastAPI: postgresql+asyncpg://tti_user:tti_dev_password_change_in_production@localhost:5432/tti_dev
# Sync URL for Alembic: postgresql+psycopg2://tti_user:tti_dev_password_change_in_production@localhost:5432/tti_dev

# Redis & Background Processing Foundation
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS Origins (JSON formatted array of allowed origins)
TTI_BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Evidence Storage Isolation
# Must point to an isolated directory physically separated from frontend public assets
TTI_EVIDENCE_STORAGE_PATH=./evidence_store

# Connector Operational Flags (Phase 1 Baseline: Inactive / Safe Mock Mode)
# LIVE COLLECTION IS STRICTLY DISABLED IN PHASE 1
TTI_TELEGRAM_CONNECTOR_ACTIVE=false
TTI_DARKWEB_CONNECTOR_ACTIVE=false

# Dummy Connector Placeholders (Do not enter real credentials in Phase 1)
TTI_TELEGRAM_API_ID=
TTI_TELEGRAM_API_HASH=
TTI_DARKWEB_SOCKS_PROXY=socks5h://127.0.0.1:9050
