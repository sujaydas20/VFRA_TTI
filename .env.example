# ==============================================================================
# TTI (Telegram Threat Intelligence) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# SECURITY NOTICE:
# - NEVER commit real credentials, tokens, or sessions to version control.
# ==============================================================================

# Application Environment
TTI_ENV=development
TTI_PROJECT_NAME="Telegram Threat Intelligence (TTI)"
TTI_API_V1_STR=/api/v1
TTI_LOG_LEVEL=INFO
TTI_SECRET_KEY=dev_insecure_secret_key_must_be_changed_in_production_min32chars!

# Multi-Tenancy Baseline
TTI_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
TTI_DEFAULT_TENANT_NAME="Default Operations Tenant"

# Database Configuration (PostgreSQL)
POSTGRES_USER=tti_user
POSTGRES_PASSWORD=tti_dev_password_change_in_production
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tti_dev

# Redis & Background Broker Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
TTI_RATE_LIMIT_BACKEND=redis

# Celery Worker Configuration
TASK_DISPATCHER=celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Telegram Bot API (Consent Bot)
TTI_TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TTI_WEBHOOK_SECRET=tti_dev_secret_token_1234567890_min32chars
TTI_WEBHOOK_URL=

# Telegram MTProto Ingestion (Telethon)
TTI_TELEGRAM_CONNECTOR_ACTIVE=true
TTI_TELEGRAM_API_ID=
TTI_TELEGRAM_API_HASH=
TTI_TELEGRAM_SESSION=
TTI_MTPROTO_ENABLED=false
TTI_MTPROTO_POLL_INTERVAL_SECONDS=30
TTI_MTPROTO_HISTORICAL_LIMIT=100
TTI_MTPROTO_BATCH_LIMIT=100
TTI_MTPROTO_EDIT_LOOKBACK=20

# Google Gemini AI Threat Intelligence Configuration
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=4096
AI_CONFIDENCE_THRESHOLD=0.75
AI_AUTO_ANALYZE_LIVE=false

# IOC Enrichment Providers
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
TTI_IOC_ENRICHMENT_API_KEY=

# Dark Web Connector (Tor SOCKS5)
TTI_DARKWEB_CONNECTOR_ACTIVE=false
TTI_DARKWEB_SOCKS_PROXY=socks5h://127.0.0.1:9050

# CORS & Evidence Storage
TTI_BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
TTI_EVIDENCE_STORAGE_PATH=./evidence_store
